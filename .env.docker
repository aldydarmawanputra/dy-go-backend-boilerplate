# Env for docker compose (app + migrate). Hostnames = compose service names.
# Dev defaults only. Postgres service credentials are set in docker-compose.yml
# (POSTGRES_*) and must match DB_* below.
APP_HOST=0.0.0.0
APP_PORT=8080
APP_ENV=development

DB_HOST=postgres
DB_PORT=5432
DB_NAME=aldy_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=change-me-in-production
JWT_ISSUER=go-backend-boilerplate
JWT_AUDIENCE=go-backend-boilerplate
JWT_EXPIRE_HOURS=24
REFRESH_TOKEN_EXPIRE_HOURS=168

CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization
CORS_ALLOW_CREDENTIALS=false

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SEC=60
AUTH_RATE_LIMIT_MAX=10

READ_TIMEOUT_SEC=10
WRITE_TIMEOUT_SEC=15
IDLE_TIMEOUT_SEC=60
BODY_LIMIT_BYTES=1048576

OTEL_ENABLED=false
OTEL_SERVICE_NAME=go-backend-boilerplate
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
OTEL_EXPORTER_OTLP_INSECURE=true

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/storage

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=
SUPABASE_PUBLIC_BASE_URL=

AUTO_MIGRATE=false

# dbmate (migrate service) reads this:
DATABASE_URL=postgres://postgres:postgres@postgres:5432/aldy_dev?sslmode=disable
