# Normalize line endings to LF in the repository.
* text=auto eol=lf

# Explicitly LF for source/config (avoids CRLF churn on Windows checkouts).
*.go      text eol=lf
*.mod     text eol=lf
*.sum     text eol=lf
*.sql     text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
Makefile  text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf

# Binary files (no EOL conversion).
*.png binary
*.jpg binary
*.gif binary
*.ico binary
